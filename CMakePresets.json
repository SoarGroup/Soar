{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "include": ["./ConanPresets.json"],
    "configurePresets": [
        {
            "name": "Release-test",
            "displayName": "Release Test Configuration",
            "inherits": "conan-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "ON",
                "SWIG": "OFF",
                "ASAN": "OFF",
                "SVS": "OFF",
                "CLI": "ON"
            }
        },
        {
            "name": "Debug-shared",
            "displayName": "Debug Shared Configuration",
            "inherits": "conan-release",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "SWIG": "OFF",
                "ASAN": "OFF",
                "SVS": "OFF",
                "CLI": "ON"
            }
        },
        {
            "name": "Release-shared",
            "displayName": "Release Shared Configuration",
            "inherits": "conan-release",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "ON",
                "SWIG": "OFF",
                "ASAN": "OFF",
                "SVS": "OFF",
                "CLI": "ON"
            }
        },
        {
            "name": "Debug-test",
            "displayName": "Debug Test Configuration",
            "inherits": "conan-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "BUILD_PERFORMANCE_TESTS": "OFF",
                "SWIG": "OFF",
                "ASAN": "OFF",
                "SVS": "OFF",
                "CLI": "ON"
            }
        },
        {
            "name": "Debug-swig",
            "displayName": "Debug with SWIG bindings",
            "inherits": "conan-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SWIG": "ON",
                "SVS": "OFF",
                "CLI": "ON",
                "BUILD_TESTS": "ON",
                "TEST_CI_ENABLED": "OFF",
                "BUILD_PERFORMANCE_TESTS": "OFF"
            }
        },
        {
            "name": "Debug-test-asan",
            "displayName": "Debug Test with ASAN",
            "inherits": "conan-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "BUILD_PERFORMANCE_TESTS": "OFF",
                "SWIG": "OFF",
                "ASAN": "ON",
                "SVS": "OFF",
                "CLI": "ON"
            }
        },
        {
            "name": "Release-svs-test",
            "displayName": "Release with SVS Test Configuration",
            "inherits": "conan-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "ON",
                "ASAN": "OFF",
                "SVS": "ON",
                "CLI": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug-shared",
            "displayName": "Build Debug Shared",
            "configurePreset": "Debug-shared"
        },
        {
            "name": "Release-shared",
            "displayName": "Build Release Shared",
            "configurePreset": "Release-shared"
        },
        {
            "name": "Debug-test",
            "displayName": "Build Debug Test",
            "configurePreset": "Debug-test"
        },
        {
            "name": "Debug-test-asan",
            "displayName": "Build Debug Test with ASAN",
            "configurePreset": "Debug-test-asan"
        },
        {
            "name": "Release-test",
            "displayName": "Build Release Test",
            "configurePreset": "Release-test"
        },
        {
            "name": "Debug-swig",
            "displayName": "Build Debug with SWIG bindings",
            "configurePreset": "Debug-swig"
        },
        {
            "name": "Release-svs-test",
            "displayName": "Build Release with SVS Test",
            "configurePreset": "Release-svs-test"
        }
    ],
    "testPresets": [
        {
            "name": "Debug-test",
            "displayName": "Test Debug",
            "configurePreset": "Debug-test",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "Debug-test-asan",
            "displayName": "Test Debug ASAN",
            "configurePreset": "Debug-test-asan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "Debug-shared",
            "displayName": "Test Debug Shared",
            "configurePreset": "Debug-shared",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "Release-test",
            "displayName": "Test Release",
            "configurePreset": "Release-test",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "Release-shared",
            "displayName": "Test Release Shared",
            "configurePreset": "Release-shared",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "Release-svs-test",
            "displayName": "Test Release with SVS",
            "configurePreset": "Release-svs-test",
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "packagePresets": [
        {
            "name": "Release-test",
            "displayName": "Package Release Test",
            "configurePreset": "Release-test",
            "packageDirectory": "${sourceDir}/"
        },
        {
            "name": "Release-shared",
            "displayName": "Package Release Shared",
            "configurePreset": "Release-shared",
            "packageDirectory": "${sourceDir}/"
        },
        {
            "name": "Release-svs-test",
            "displayName": "Package Release with SVS Test",
            "configurePreset": "Release-svs-test",
            "generators": ["TGZ"],
            "packageDirectory": "${sourceDir}/"
        }
    ],
    "workflowPresets": [
        {
            "name": "Debug-test-workflow",
            "displayName": "Debug Test Workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "Debug-test"
                },
                {
                    "type": "build",
                    "name": "Debug-test"
                },
                {
                    "type": "test",
                    "name": "Debug-test"
                }
            ]
        },
        {
            "name": "Debug-test-asan-workflow",
            "displayName": "Debug Test Workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "Debug-test-asan"
                },
                {
                    "type": "build",
                    "name": "Debug-test-asan"
                },
                {
                    "type": "test",
                    "name": "Debug-test-asan"
                }
            ]
        },
        {
            "name": "Release-test-workflow",
            "displayName": "Release Test Workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "Release-test"
                },
                {
                    "type": "build",
                    "name": "Release-test"
                },
                {
                    "type": "test",
                    "name": "Release-test"
                }
            ]
        }
    ]
}
